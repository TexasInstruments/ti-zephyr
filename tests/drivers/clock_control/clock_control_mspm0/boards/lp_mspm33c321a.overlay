#include <freq.h>

&hfxt {
	status = "okay";
};

&lfxt {
	status = "okay";
};

&hfclk {
	clocks = <&hfxt>;
	status = "okay";
};

&canclk {
	clocks = <&syspll>;
	status = "okay";
};

&mfpclk {
	status = "okay";
};

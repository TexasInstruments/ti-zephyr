[general]
regex-style-search=true
ignore=title-trailing-punctuation, title-max-length, body-hard-tab, B1
verbosity = 3
ignore-merge-commits=false
ignore-revert-commits=false
ignore-fixup-commits=false
ignore-squash-commits=false
debug = false

extra-path=../zephyr/scripts/gitlint

[title-max-length-no-revert]
line-length=72

[body-min-line-count]
min-line-count=1

[body-max-line-count]
max-line-count=200

[title-starts-with-subsystem]
# <area>: <subject>
regex = ^([^:]+):\s(.+)$

[max-line-length-with-exceptions]
line-length=75

[body-min-length]
min-length=3

[body-is-missing]
ignore-merge-commits=false

[ignore-by-author-name]
regex=^dependabot\[bot\]$
ignore=all

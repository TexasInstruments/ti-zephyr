</parameternamelist>
<parameterdescription>
<para>Devicetree node identifier of the consumer. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="see"><para><ref refid="group__mux__interface_1ga1fcf4fd9a94643c1b778994f76b64150" kindref="member">MUX_CONTROL_DT_SPEC_DEFINE_BY_IDX()</ref> </para>
</simplesect>
</para>

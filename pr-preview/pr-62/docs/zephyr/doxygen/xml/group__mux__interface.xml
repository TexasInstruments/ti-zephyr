      <memberdef kind="function" id="group__mux__interface_1gad1b56b4430fca99f03bdf2b0ad6725c5" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int mux_state_apply</definition>
        <argsstring>(const struct device *dev, const struct mux_state *mstate)</argsstring>
        <name>mux_state_apply</name>
        <param>
          <type>const struct <ref refid="structdevice" kindref="compound">device</ref> *</type>

<para>Lowercase-and-underscores name from the <computeroutput>mux-control-names</computeroutput> property. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="see"><para><ref refid="group__devicetree-mux_1ga8ffbc045c3a5df61e843fd5d48731701" kindref="member">MUX_CONTROL_DT_GET_BY_NAME()</ref> </para>
</simplesect>
</para>
        </detaileddescription>

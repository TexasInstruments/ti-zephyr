      <memberdef kind="define" id="group__display__panel__dt_1gaa0b9f908e93148d911cdc87a40b442e8" prot="public" static="no">
        <name>ARGB8888</name>
        <param><defname>r</defname></param>
        <param><defname>g</defname></param>
        <param><defname>b</defname></param>
        <param><defname>a</defname></param>
        <initializer>(((b) &lt;&lt; 0) | ((g) &lt;&lt; 8) | ((<ref refid="asm-macro-32-bit-gnu_8h_1af16d2973cfd145a2ebdbf9528d5d9ae2" kindref="member">r</ref>) &lt;&lt; 16) | ((a) &lt;&lt; 24))</initializer>
        <briefdescription>
<para>Pack color components into a 32-bit ARGB8888 value. </para>
        </briefdescription>
        <detaileddescription>
<para>This macro is intended for use in devicetree files to specify color values.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>r</parametername>
</parameternamelist>
<parameterdescription>
<para>Red component (0-255) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>g</parametername>
</parameternamelist>
<parameterdescription>
<para>Green component (0-255) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>b</parametername>
</parameternamelist>
<parameterdescription>
<para>Blue component (0-255) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>a</parametername>
</parameternamelist>
<parameterdescription>
<para>Alpha component (0-255) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>

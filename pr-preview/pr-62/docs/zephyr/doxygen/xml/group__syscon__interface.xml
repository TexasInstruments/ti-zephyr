      <memberdef kind="function" id="group__syscon__interface_1ga453503af7f04d6106db93e54e9072a6c" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int syscon_update_bits</definition>
        <argsstring>(const struct device *dev, uint32_t reg, uint32_t mask, uint32_t val)</argsstring>
        <name>syscon_update_bits</name>
        <param>
          <type>const struct <ref refid="structdevice" kindref="compound">device</ref> *</type>
          <declname>dev</declname>
        </param>
        <param>
          <type><ref refid="stdint_8h_1a0a8582351ac627ee8bde2973c825e47f" kindref="member">uint32_t</ref></type>
          <declname>reg</declname>
        </param>
        <param>
          <type><ref refid="stdint_8h_1a0a8582351ac627ee8bde2973c825e47f" kindref="member">uint32_t</ref></type>
          <declname>mask</declname>
        </param>
        <param>
          <type><ref refid="stdint_8h_1a0a8582351ac627ee8bde2973c825e47f" kindref="member">uint32_t</ref></type>
          <declname>val</declname>
        </param>
        <briefdescription>
<para>Atomically update bits in a syscon register. </para>
        </briefdescription>
        <detaileddescription>
<para>Performs a read-modify-write on a register under the driver&apos;s internal lock. Bits selected by <emphasis>mask</emphasis> are cleared and replaced with the corresponding bits from <emphasis>val</emphasis>. Equivalent to: <verbatim>syscon_read_reg(dev, reg, &amp;tmp);
tmp = (tmp &amp; ~mask) | (val &amp; mask);
syscon_write_reg(dev, reg, tmp);
</verbatim></para>
<para>but executed atomically with respect to other syscon operations on the same device.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>dev</parametername>
</parameternamelist>
<parameterdescription>
<para>The syscon device. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>reg</parametername>
</parameternamelist>
<parameterdescription>
<para>The register offset. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>mask</parametername>
</parameternamelist>
<parameterdescription>
<para>Bitmask of bits to modify. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>val</parametername>
</parameternamelist>
<parameterdescription>
<para>New values for the bits selected by <emphasis>mask</emphasis>.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>0</parametername>
</parameternamelist>
<parameterdescription>
<para>on success. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>-ENOSYS</parametername>
</parameternamelist>
<parameterdescription>
<para>If the API or function isn&apos;t implemented. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>

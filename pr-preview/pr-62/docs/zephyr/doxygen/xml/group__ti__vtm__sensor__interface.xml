          <name>TI_VTM_TRIG_TH0</name>
          <initializer>= SENSOR_TRIG_PRIV_START + 0</initializer>
          <briefdescription>
<para>Low temperature trip (LT_TH0): fires when temp falls below threshold. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="group__ti__vtm__sensor__interface_1ggaf0f90caaf6fb8b86ff14ec8d3c6925f0a518b1485ae1e051019292858efc7156b" prot="public">
          <name>TI_VTM_TRIG_TH1</name>
          <initializer>= SENSOR_TRIG_PRIV_START + 1</initializer>
          <briefdescription>
<para>High temperature trip (GT_TH1): fires when temp rises above threshold. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="group__ti__vtm__sensor__interface_1ggaf0f90caaf6fb8b86ff14ec8d3c6925f0a70d2bfd364d55361da18423619bfea0b" prot="public">
          <name>TI_VTM_TRIG_TH2</name>
          <initializer>= SENSOR_TRIG_PRIV_START + 2</initializer>
          <briefdescription>
<para>Critical temperature trip (GT_TH2): fires when temp rises above threshold. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>

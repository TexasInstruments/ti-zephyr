# Config for EQEP position/speed sample

# SPDX-FileCopyrightText: Copyright (c) 2026 Texas Instruments
# SPDX-License-Identifier: BSD-3-Clause

config APP_EQEP_LINES_PER_REV
	int "Encoder lines per mechanical revolution"
	default 1000
	help
	  Number of quadrature lines the encoder produces per mechanical
	  revolution. The decoder is configured for 4x counting, so the
	  effective counts per revolution used for the speed calculation is
	  four times this value.

config APP_EQEP_UPDATE_INTERVAL_MS
	int "Speed measurement update interval (ms)"
	default 200
	help
	  Period, in milliseconds, between two position samples used to
	  compute the rotational speed.

config APP_EPWM_OUTPUT_FREQ_HZ
	int "Simulated encoder electrical frequency (Hz)"
	default 5000
	help
	  Output frequency of the two EHRPWM instances used to simulate the
	  encoder's quadrature A/B signals. One PWM period corresponds to one
	  quadrature (electrical) cycle, i.e. 4 EQEP counts.

source "Kconfig.zephyr"

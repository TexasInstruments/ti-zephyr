mainmenu "TI DSS sprite animation sample"

source "Kconfig.zephyr"

config HEAP_MEM_POOL_ADD_SIZE_SAMPLE
	int "Framebuffer heap pool addition (bytes)"
	default 16777216
	help
	  Additional bytes added to the system heap pool.  Must be at least
	  2 x width x height x 4 bytes for the two ARGB8888 framebuffers.
	  Default covers 2 x 1920x1080 (16 MB).

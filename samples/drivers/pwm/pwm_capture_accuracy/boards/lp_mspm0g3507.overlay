 * SPDX-License-Identifier: BSD-3-Clause
 *
 * PWM output : TIMA0/CC2 on PA15  (pwm-out)
 * PWM capture: TIMA1/CC0 on PB4   (pwm-cap)
 *
 * Wire required: PA15 -> PB4
 */

/ {
	aliases {
		pwm-out = &pwma0;
		pwm-cap = &pwma1;
	};
};

/*
 * Override pwma0 to CC2/PA15 so the LED pin (PA0/CC0) stays free.
 * Override TIMA0 clock: 80 MHz / 1 / 16 = 5 MHz for fine PWM resolution.
 * At 5 MHz: 5 kHz period = 1000 cycles -> max quantization ~1000 ppm.
 */
&tima0 {
	ti,clk-div = <1>;
	ti,clk-prescaler = <15>;
};

&pwma0 {
	pinctrl-0 = <&tima0_ccp2_pa15>;
	ti,cc-index = <2>;
};

&pinctrl {
	tima1_ccp0_pb4: tima1_ccp0_pb4 {
		input-enable;
		bias-pull-down;
	};
};

&tima1 {
	ti,clk-div = <1>;
	ti,clk-prescaler = <15>;
	status = "okay";

	pwma1: pwma1 {
		pinctrl-0 = <&tima1_ccp0_pb4>;
		pinctrl-names = "default";
		ti,cc-index = <0>;
		ti,cc-mode = "PULSE_WIDTH";
		ti,period = <0xffff>;
		status = "okay";
	};
};

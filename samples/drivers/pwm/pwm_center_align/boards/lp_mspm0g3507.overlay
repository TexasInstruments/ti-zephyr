 *
 * Switch TIMA0/CC0 (PA0) to center-aligned (up-down) counting mode.
 * The period in cycles is unchanged from the board DTS; the driver
 * automatically divides it by 2 for the LOAD register in this mode.
 */

/ {
	aliases {
		pwm-out = &pwma0;
	};
};

&pwma0 {
	ti,pwm-mode = "CENTER_ALIGN";
};

<screen>
	<view extends="lv_obj" width="#const_screen_w" height="#const_screen_h" scrollable="false">
		<style name="style_screen_base" />

		<nav_header title="Options" />
		<btn_back x="0" y="0">
			<screen_create_event screen="home" trigger="clicked" />
		</btn_back>

		<lv_obj
			x="#const_gutter"
			y="68"
			width="#const_content_w"
			height="content"
			scrollable="false"
			clickable="false"
			style_bg_opa="0"
			style_border_width="0"
			style_shadow_width="0"
			style_pad_all="0"
			style_layout="flex"
			style_flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="end"
			style_flex_track_place="end"
		>
			<label text="Spin speed">
				<style name="style_body_strong" />
				<style name="style_ink" />
			</label>
			<label text="rpm">
				<style name="style_micro" />
				<style name="style_ink_3" />
			</label>
		</lv_obj>

		<row x="#const_gutter" y="97" gap="10">
			<pill_spin text="400" value="400" />
			<pill_spin text="600" value="600" />
			<pill_spin text="800" value="800" />
			<pill_spin text="1000" value="1000" />
			<pill_spin text="1200" value="1200" />
			<pill_spin text="1400" value="1400" />
		</row>

		<lv_obj
			x="#const_gutter"
			y="167"
			width="#const_content_w"
			height="content"
			scrollable="false"
			clickable="false"
			style_bg_opa="0"
			style_border_width="0"
			style_shadow_width="0"
			style_pad_all="0"
			style_layout="flex"
			style_flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="end"
			style_flex_track_place="end"
		>
			<label text="Water level">
				<style name="style_body_strong" />
				<style name="style_ink" />
			</label>
			<row gap="2" cross_align="end">
				<label text="62" bind_text="subject_water_target" bind_text-fmt="%d">
					<style name="style_body_strong" />
					<style name="style_ink" />
				</label>
				<label text="%">
					<style name="style_micro" />
					<style name="style_ink_3" />
				</label>
			</row>
		</lv_obj>

		<slider_water x="#const_gutter" y="200" />

		<row x="#const_gutter" y="240" gap="10">
			<row_option
				w="140"
				icon="icon_opt_prewash"
				title="Prewash"
				subtitle="Adds 18 min"
				value="subject_opt_prewash"
			/>
			<row_option
				w="140"
				icon="icon_opt_rinse"
				title="Extra rinse"
				subtitle="Adds 12 min"
				value="subject_opt_rinse"
			/>
			<row_option
				w="140"
				icon="icon_opt_delay"
				title="Delay start"
				subtitle="Waits 3 hrs"
				value="subject_opt_delay"
			/>
		</row>
	</view>
</screen>

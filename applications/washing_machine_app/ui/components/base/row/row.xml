<component>
  <api>
    <prop name="pad_left" type="int" default="0" />
    <prop name="pad_right" type="int" default="0" />
    <prop name="pad_top" type="int" default="0" />
    <prop name="pad_bottom" type="int" default="0" />
    <prop name="gap" type="int" default="0" />
    <prop name="grow" type="int" default="0" />
    <prop name="main_align" type="enum:lv_flex_align" default="start" />
    <prop name="cross_align" type="enum:lv_flex_align" default="start" />
  </api>
  <styles>
    <style name="style_base" layout="flex" flex_flow="row" />
  </styles>
  <view
    extends="container"
    style_pad_left="$pad_left"
    style_pad_right="$pad_right"
    style_pad_top="$pad_top"
    style_pad_bottom="$pad_bottom"
    style_pad_column="$gap"
    flex_grow="$grow"
    style_flex_main_place="$main_align"
    style_flex_cross_place="$cross_align"
    style_flex_track_place="$cross_align">
    <style name="style_base" />
  </view>
</component>

<component>
  <previews>
    <preview width="200" height="60" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="text"      type="string" default="Running"/>
    <prop name="tone"      type="style"  default="style_chip_fill_accent"/>
    <prop name="tone_dot"  type="style"  default="style_chip_dot_accent"/>
    <prop name="tone_text" type="style"  default="style_chip_text_accent"/>
  </api>
  <styles>
    <style name="style_base" width="content" height="30" radius="32767"
           pad_left="11" pad_right="13" pad_column="7"
           layout="flex" flex_flow="row"
           flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
    <style name="style_dot" width="8" height="8" radius="32767"/>
  </styles>
  <view extends="lv_obj" scrollable="false">
    <remove_style_all/>
    <style name="style_base"/>
    <style name="$tone"/>
    <lv_obj scrollable="false">
      <remove_style_all/>
      <style name="style_dot"/>
      <style name="$tone_dot"/>
    </lv_obj>
    <label text="$text">
      <style name="style_chip"/>
      <style name="$tone_text"/>
    </label>
  </view>
</component>

<component>
  <previews>
    <preview width="120" height="90" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="icon" type="image" default="icon_options"/>
  </api>
  <styles>
    <style name="style_base" width="44" height="44" radius="32767" pad_all="0"
           layout="flex" flex_flow="row"
           flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
  </styles>
  <view extends="lv_button">
    <remove_style_all/>
    <style name="style_base"/>
    <style name="style_card_surface"/>
    <style name="style_btn_ghost_pressed" selector="pressed"/>
    <style name="style_pill"/>
    <lv_image src="$icon" clickable="false">
      <style name="style_icon_2"/>
    </lv_image>
  </view>
</component>

<component>
	<previews>
		<preview width="220" height="90" style_bg_color="0xF0F4F6" />
	</previews>
	<api>
		<prop name="title" type="string" default="Prewash" />
		<prop name="subtitle" type="string" default="Adds 18 min" />
		<prop name="value" type="subject" default="subject_opt_prewash" />
		<prop name="icon" type="image" default="icon_opt_prewash" />
		<prop name="w" type="int" default="140" />
	</api>
	<styles>
		<style
			name="style_base"
			pad_top="8"
			pad_bottom="8"
			pad_left="5"
			pad_right="5"
			pad_column="10"
			radius="#const_radius_lg"
			layout="flex"
			flex_flow="row"
			flex_main_place="center"
			flex_cross_place="center"
			flex_track_place="center"
		/>
		<style name="style_edge" border_color="#const_border" border_width="2" border_opa="100%" />
	</styles>
	<view
		extends="lv_button"
		width="$w"
		height="content"
		state_trickle="true"
		style_shadow_width="0"
		style_outline_width="0"
	>
		<style name="style_base" />
		<style name="style_card_surface" />
		<style name="style_edge" />
		<style name="style_btn_ghost_pressed" selector="pressed" />
		<style name="style_card_selected_edge" selector="checked" />

		<lv_image src="$icon" clickable="false">
			<style name="style_icon_3" />
			<style name="style_icon_accent" selector="checked" />
		</lv_image>
		<column gap="1" clickable="false">
			<label text="$title" clickable="false">
				<style name="style_body_strong" />
				<style name="style_ink" />
			</label>
			<label text="$subtitle" clickable="false">
				<style name="style_micro" />
				<style name="style_ink_3" />
			</label>
		</column>
		<bind_state_if_eq subject="$value" ref_value="#ref_on" state="checked" />
		<subject_toggle_event subject="$value" trigger="clicked" />
	</view>
</component>

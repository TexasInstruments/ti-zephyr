<component>
  <previews>
    <preview width="120" height="110" style_bg_color="0xFBFBFC"/>
  </previews>
  <api>
    <prop name="title" type="string" default="Wash"/>
    <prop name="icon"  type="image"  default="icon_ph_wash"/>
    <prop name="index" type="int"    default="1"/>
  </api>
  <view extends="lv_obj" width="content" height="content" scrollable="false" clickable="false"
        style_bg_opa="0" style_border_width="0" style_shadow_width="0"
        style_pad_all="0" style_pad_column="7"
        style_layout="flex" style_flex_flow="row"
        style_flex_main_place="center"
        style_flex_cross_place="center" style_flex_track_place="center">

    <lv_image src="$icon" clickable="false">
      <style name="style_icon_3"/>
      <style name="style_icon_accent" selector="checked"/>
      <bind_state_if_ge subject="subject_phase" ref_value="$index" state="checked"/>
    </lv_image>

    <label text="$title" clickable="false">
      <style name="style_micro"/>
      <style name="style_ink_3"/>
      <style name="style_ink" selector="checked"/>
      <bind_state_if_ge subject="subject_phase" ref_value="$index" state="checked"/>
    </label>

    <lv_obj width="5" height="5" scrollable="false" clickable="false"
            style_radius="32767" style_border_width="0" style_shadow_width="0"
            style_pad_all="0">
      <style name="style_chip_dot_accent"/>
      <bind_flag_if_not_eq flag="hidden" subject="subject_phase" ref_value="$index"/>
    </lv_obj>
  </view>
</component>

<component>
  <previews>
    <preview width="160" height="90" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="text"  type="string" default="1200"/>
    <prop name="value" type="int"    default="1200"/>
    <prop name="w"     type="int"    default="65"/>
  </api>
  <styles>
    <style name="style_base" height="46" radius="32767" pad_all="0"
           layout="flex" flex_flow="row"
           flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
  </styles>
  <view extends="lv_button" width="$w" state_trickle="true"
        style_shadow_width="0" style_outline_width="0">
    <style name="style_base"/>
    <style name="style_card_surface"/>
    <style name="style_btn_ghost_pressed" selector="pressed"/>
    <style name="style_card_selected" selector="checked"/>
    <style name="style_card_selected_pressed" selector="checked|pressed"/>
    <style name="style_pill"/>

    <label text="$text" clickable="false">
      <style name="style_body_strong"/>
      <style name="style_ink"/>
      <style name="style_ink_inv" selector="checked"/>
    </label>
    <bind_state_if_eq subject="subject_spin_rpm" ref_value="$value" state="checked"/>
    <subject_set_int_event subject="subject_spin_rpm" value="$value" trigger="clicked"/>
  </view>
</component>

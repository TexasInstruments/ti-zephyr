<component>
  <previews>
    <preview width="240" height="240" style_bg_color="0xF0F4F6"/>
  </previews>

  <styles>
    <style name="style_arc" width="180" height="180" align="center"
           arc_width="6" pad_all="7"/>
    <style name="style_ring_stroke" arc_width="6"/>
    <style name="style_ring_knob" bg_opa="0%" border_width="0" shadow_width="0"
           pad_all="0"/>
  </styles>

  <view extends="lv_obj" width="200" height="200" scrollable="false"
        style_bg_opa="0" style_border_width="0" style_shadow_width="0"
        style_pad_all="0">

    <lv_arc name="ring" min_value="0" max_value="100" rotation="270"
            bg_start_angle="0" bg_end_angle="360" mode="normal"
            bind_value="subject_progress" clickable="false">
      <bind_flag_if_not_eq flag="hidden" subject="subject_state" ref_value="#ref_state_running"/>
      <remove_style_all/>
      <style name="style_arc"/>
      <style name="style_arc_track"/>
      <style name="style_arc_ind" selector="indicator"/>
      <style name="style_ring_stroke"/>
      <style name="style_ring_stroke" selector="indicator"/>
      <style name="style_ring_knob" selector="knob"/>
    </lv_arc>

    <!-- Named: custom/wash_sim.c finds this by name each tick to set its rotation. -->
    <lv_image name="drum_load" src="img_clothes" align="center" clickable="false"/>

    <lv_image src="img_door" align="center" clickable="false"/>
  </view>
</component>

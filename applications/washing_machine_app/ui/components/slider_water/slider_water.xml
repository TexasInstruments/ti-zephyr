<component>
  <previews>
    <preview width="480" height="80" style_bg_color="0xF0F4F6"/>
  </previews>
  <styles>
    <style name="style_main" width="#const_content_w" height="20"
           bg_color="#const_track" bg_opa="100%"
           radius="32767" border_width="0" pad_all="0"/>
    <style name="style_indicator" bg_color="#const_accent" bg_opa="100%"
           radius="32767"/>
    <style name="style_knob" bg_color="#const_on_accent" bg_opa="100%"
           radius="32767" pad_all="4"
           border_color="#const_border" border_width="1" border_opa="100%"/>
  </styles>
  <view extends="lv_slider" min_value="0" max_value="100"
        bind_value="subject_water_target" ext_click_area="18">
    <remove_style_all/>
    <style name="style_main"/>
    <style name="style_indicator" selector="indicator"/>
    <style name="style_knob" selector="knob"/>
  </view>
</component>

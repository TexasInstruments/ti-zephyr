<component>
  <previews>
    <preview width="300" height="80" style_bg_color="0xF0F4F6"/>
  </previews>
  <styles>
    <style name="style_main" width="226" height="10"
           bg_color="#const_temp_20" bg_opa="100%"
           bg_grad_color="#const_temp_90" bg_grad_dir="hor"
           radius="32767" border_width="0"
           pad_ver="0" pad_hor="11"/>
    <style name="style_indicator" bg_opa="0%" radius="32767"/>
    <style name="style_knob" bg_color="#const_on_accent" bg_opa="100%"
           radius="32767" pad_all="6"
           border_color="#const_border" border_width="1" border_opa="100%"/>
  </styles>
  <!-- Writes a stop index 0..4, not degrees; custom/wash_logic.c maps it to subject_temp_c. -->
  <view extends="lv_slider" min_value="0" max_value="4"
        bind_value="subject_temp_idx" ext_click_area="18">
    <remove_style_all/>
    <style name="style_main"/>
    <style name="style_indicator" selector="indicator"/>
    <style name="style_knob" selector="knob"/>
  </view>
</component>

<component>
  <previews>
    <preview width="480" height="120" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="text"         type="string" default="START"/>
    <prop name="hint"         type="string" default="Long press"/>
    <prop name="hide_hint"    type="bool"   default="true"/>
    <prop name="tone"         type="style"  default="style_key_accent"/>
    <prop name="tone_pressed" type="style"  default="style_key_accent_pressed"/>
  </api>
  <styles>
    <style name="style_base" align="bottom_mid" y="24"
           width="112" height="70"
           radius="#const_radius_lg" pad_all="0" pad_bottom="24" pad_row="1"
           layout="flex" flex_flow="column"
           flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
  </styles>
  <view extends="lv_button" style_shadow_width="0" style_outline_width="0">
    <remove_style_all/>
    <style name="style_base"/>
    <style name="$tone"/>
    <style name="$tone_pressed" selector="pressed"/>

    <label text="$hint" hidden="$hide_hint" clickable="false" event_bubble="true">
      <style name="style_key_hint"/>
      <style name="style_ink_inv"/>
    </label>
    <label text="$text" clickable="false" event_bubble="true">
      <style name="style_key_legend"/>
      <style name="style_ink_inv"/>
    </label>
  </view>
</component>

<component>
  <previews>
    <preview width="300" height="140" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="w" type="int" default="380"/>
  </api>
  <view extends="lv_obj" width="$w" height="content" scrollable="false" clickable="false"
        style_pad_left="20" style_pad_right="20" style_pad_top="7" style_pad_bottom="7"
        style_layout="flex" style_flex_flow="row"
        style_flex_main_place="space_between" style_flex_cross_place="center"
        style_flex_track_place="center"
        style_shadow_width="0" style_outline_width="0">
    <style name="style_card_surface"/>
    <phase_step title="Pre"   icon="icon_ph_pre"   index="#ref_phase_prewash"/>
    <phase_step title="Wash"  icon="icon_ph_wash"  index="#ref_phase_wash"/>
    <phase_step title="Rinse" icon="icon_ph_rinse" index="#ref_phase_rinse"/>
    <phase_step title="Spin"  icon="icon_ph_spin"  index="#ref_phase_spin"/>
  </view>
</component>

<component>
  <previews>
    <preview width="120" height="110" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="icon"  type="image" default="icon_prog_cotton"/>
    <prop name="index" type="int"   default="0"/>
  </api>
  <styles>
    <style name="style_base" width="52" height="52" radius="32767" pad_all="0"
           layout="flex" flex_flow="row"
           flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
  </styles>
  <view extends="lv_button" state_trickle="true">
    <remove_style_all/>
    <style name="style_base"/>
    <style name="style_card_surface"/>
    <style name="style_btn_ghost_pressed" selector="pressed"/>
    <style name="style_card_selected" selector="checked"/>
    <style name="style_card_selected_pressed" selector="checked|pressed"/>
    <style name="style_pill"/>

    <lv_image src="$icon" clickable="false">
      <style name="style_icon_ink"/>
      <style name="style_icon_inv" selector="checked"/>
    </lv_image>
    <bind_state_if_eq subject="subject_program" ref_value="$index" state="checked"/>
    <subject_set_int_event subject="subject_program" value="$index" trigger="clicked"/>
  </view>
</component>

<component>
  <previews>
    <preview width="480" height="90" style_bg_color="0xF0F4F6"/>
  </previews>
  <api>
    <prop name="title" type="string" default="Settings"/>
  </api>
  <view extends="lv_obj" width="#const_screen_w" height="58" scrollable="false"
        clickable="false"
        style_bg_opa="0" style_border_width="0" style_shadow_width="0"
        style_pad_left="60" style_pad_right="16"
        style_layout="flex" style_flex_flow="row"
        style_flex_cross_place="center" style_flex_track_place="center">
    <label text="$title">
      <style name="style_heading"/>
      <style name="style_ink"/>
    </label>
  </view>
</component>

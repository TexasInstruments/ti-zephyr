<component>
	<api>
		<prop name="thumbnail" type="image" default="image_contact_small" />
		<prop name="time" type="string" default="09:43" />
		<prop name="title" type="string" default="Title" />
		<prop name="message" type="string" default="Subtitle" />
	</api>

	<styles>
		<style
			name="style_base"
			height="content"
			width="100%"
			bg_opa="0%"
			border_side="bottom"
			border_width="1"
			border_opa="12%"
		/>
		<style name="style_thumbnail" width="40" height="40" radius="20" />
	</styles>
	<view extends="row" height="content" padding_side="12" padding_inside="12" style_pad_left="0">
		<style name="style_base" />
		<image src="$thumbnail">
			<style name="style_thumbnail" />
		</image>
		<column grow="1" height="content" padding_side="0" padding_inside="-4">
			<h4 width="100%" height="content" text="$title" style_text_line_space="-6" />
			<text
				width="100%"
				height="content"
				text="$message"
				font="font_md"
				style_text_opa="64%"
				style_text_line_space="-6"
			/>
			<text width="100%" height="content" text="$time" font="font_xs" style_pad_top="8" style_text_opa="40%" />
		</column>
	</view>
</component>

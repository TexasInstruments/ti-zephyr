<component>
	<styles>
		<style
			name="style_base"
			bg_color="#color_bg"
			height="content"
			width="100%"
			bg_opa="100%"
			pad_all="#base_lib_unit_xl"
			pad_row="0"
			flex_grow="1"
			radius="#base_lib_unit_xl"
		/>
		<!-- Keep the scrollbar ends out of the rounded corners (inset by the radius);
		     the container does not use clip_corner, which would cost ARGB8888 layers. -->
		<style name="style_scrollbar_inset" pad_top="#base_lib_unit_xl" pad_bottom="#base_lib_unit_xl" />
	</styles>
	<view extends="column">
		<style name="style_base" />
		<style name="style_scrollbar" selector="scrollbar" />
		<style name="style_scrollbar_inset" selector="scrollbar" />
	</view>
</component>

<component>
	<api>
		<prop name="thumbnail" type="image" default="image_contact_lukas_small" />
		<prop name="contact_name" type="string" default="This is a very very long name name " />
		<prop name="email" type="string" default="thisisaverylongemailaddress@verylongemaladdress.com" />
		<prop name="phone" type="string" default="+1 567 4533" />
	</api>

	<styles>
		<style
			name="style_base"
			height="content"
			width="100%"
			bg_opa="0%"
			border_side="bottom"
			border_width="1"
			border_opa="12%"
		/>
		<style name="style_thumbnail" width="40" height="40" radius="20" />
	</styles>
	<view
		extends="row"
		height="content"
		padding_side="12"
		padding_inside="12"
		style_pad_left="0"
		vertical_align="center"
		clickable="true"
	>
		<style name="style_base" />
		<image src="$thumbnail">
			<style name="style_thumbnail" />
		</image>
		<column grow="1" padding_inside="-6" clickable="false">
			<h3
				width="100%"
				height="content"
				text="$contact_name"
				flex_in_new_track="true"
				long_mode="dots"
				style_text_line_space="-8"
			/>
			<h4
				width="100%"
				height="content"
				text="$email"
				style_text_opa="60%"
				style_text_line_space="-6"
				long_mode="dots"
			/>
		</column>

		<!-- <subject_set_string_event subject="subject_contact_img" trigger="clicked" value="$thumbnail" /> -->
		<subject_set_string_event subject="subject_contact_email" trigger="clicked" value="$email" />
		<subject_set_string_event subject="subject_contact_name" trigger="clicked" value="$contact_name" />
		<subject_set_string_event subject="subject_contact_phone" trigger="clicked" value="$phone" />

		<event_cb callback="on_contact_clicked_cb" trigger="clicked" user_data="$email" />
	</view>
</component>

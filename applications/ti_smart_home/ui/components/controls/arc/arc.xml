<component>
	<api>
		<prop name="subject" type="subject" default="subject_test" />
	</api>

	<styles>
		<style name="style_arc" arc_width="#base_lib_unit_lg" arc_color="#color_accent" arc_opa="16%" />
		<style name="style_arc_indicator" arc_width="#base_lib_unit_lg" arc_color="#color_accent" arc_opa="100%" />
		<style name="style_arc_knob" bg_color="#color_accent_text" pad_all="-4" />
	</styles>
	<view extends="lv_arc" bind_value="$subject">
		<style name="style_arc" />
		<style name="style_arc_indicator" selector="indicator" />
		<style name="style_arc_knob" selector="knob" />
	</view>
</component>

<component>
	<api>
		<prop name="subject" type="subject" default="subject_test" />
	</api>
	<styles>
		<style
			name="style_slider"
			height="#base_lib_unit_lg"
			bg_color="#color_accent"
			bg_opa="16%"
			radius="#base_lib_radius_md"
		/>
		<style name="style_slider_indicator" bg_color="#color_accent" bg_opa="100%" radius="#base_lib_radius_md" />
		<style name="style_slider_knob" bg_color="#color_accent_text" pad_left="3" pad_right="-10" pad_ver="-4" />
		<style name="style_slider_knob_pressed" transform_height="0" transform_width="0" />
	</styles>
	<view extends="lv_slider" value="50" bind_value="$subject">
		<style name="style_slider" />
		<style name="style_slider_indicator" selector="indicator" />
		<style name="style_slider_knob" selector="knob" />
		<style name="style_slider_knob_pressed" selector="knob|pressed" />
	</view>
</component>

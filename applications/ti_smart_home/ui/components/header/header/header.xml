<component>
	<previews>
		<preview width="720" height="40" />
	</previews>
	<styles>
		<style name="style_base" width="100%" height="40" flex_track_place="center" flex_cross_place="center" />
		<style name="style_logo_button" width="content" height="100%" bg_opa="0%" border_width="0" pad_all="0" />
	</styles>

	<view
		extends="row"
		scrollable="false"
		padding_side="0"
		vertical_align="center"
		content_align="center"
		padding_inside="#base_lib_unit_md"
	>
		<style name="style_base" />
		<style name="style_text" />

		<!-- The logo doubles as the "home" affordance, so the bottom bar isn't the
		     only way back to the main screen. -->
		<lv_button>
			<remove_style_all />
			<style name="style_logo_button" />
			<style name="style_button_pressed" selector="pressed" />
			<subject_set_int_event subject="subject_nav_index" value="#ref_nav_home" trigger="clicked" />
			<screen_create_event anim_type="fade_in" duration="200" screen="screen_home" />
			<!-- Pre-scaled asset (logostrip_large at 179/256), not transform_scale: a
			     transformed widget is rendered through an ARGB8888 layer on every redraw. -->
			<image_mono src="logostrip_small" event_bubble="true" clickable="false" />
		</lv_button>

		<spacer />
		<time bind_subject_hour="subject_hour" bind_subject_minute="subject_minute" />
		<date />
		<image_mono src="icon_wifi" />
	</view>
</component>

<component>
	<previews>
		<preview width="720" height="96" />
	</previews>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="96"
			bg_color="#color_bg"
			bg_opa="100%"
			border_side="top"
			border_width="1"
			border_color="#color_text"
			border_opa="10%"
			radius="0"
			pad_all="0"
		/>
		<!-- Buttons stay content-sized; the row's space_evenly does the distribution -->
		<style name="style_tab" height="100%" bg_opa="0%" border_width="0" radius="0" pad_hor="#base_lib_unit_lg" />
		<style name="style_tab_active" text_color="#color_accent" image_recolor="#color_accent" />
	</styles>

	<!-- Screens are created on demand, so the active tab is made non-clickable:
	     re-tapping it would otherwise rebuild the screen that is already shown. -->
	<view
		extends="row"
		padding_side="0"
		padding_inside="0"
		horizontal_align="space_evenly"
		vertical_align="center"
		scrollable="false"
	>
		<style name="style_base" />

		<lv_button>
			<remove_style_all />
			<style name="style_tab" />
			<style name="style_button_pressed" selector="pressed" />
			<subject_set_int_event subject="subject_nav_index" value="#ref_nav_smart_home" trigger="clicked" />
			<screen_create_event anim_type="fade_in" duration="200" screen="screen_smart_home" />
			<bind_flag_if_not_eq flag="clickable" subject="subject_nav_index" ref_value="#ref_nav_smart_home" />
			<column
				height="100%"
				padding_side="0"
				padding_inside="#base_lib_unit_sm"
				horizontal_align="center"
				vertical_align="center"
				clickable="false"
				event_bubble="true"
			>
				<image_mono src="icon_smart_home">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_smart_home" />
				</image_mono>
				<text text="Smart Home" font="font_md">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_smart_home" />
				</text>
			</column>
		</lv_button>

		<lv_button>
			<remove_style_all />
			<style name="style_tab" />
			<style name="style_button_pressed" selector="pressed" />
			<subject_set_int_event subject="subject_nav_index" value="#ref_nav_ev" trigger="clicked" />
			<screen_create_event anim_type="fade_in" duration="200" screen="screen_ev_charging" />
			<bind_flag_if_not_eq flag="clickable" subject="subject_nav_index" ref_value="#ref_nav_ev" />
			<column
				height="100%"
				padding_side="0"
				padding_inside="#base_lib_unit_sm"
				horizontal_align="center"
				vertical_align="center"
				clickable="false"
				event_bubble="true"
			>
				<image_mono src="icon_charge">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_ev" />
				</image_mono>
				<text text="EV Charging" font="font_md">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_ev" />
				</text>
			</column>
		</lv_button>

		<lv_button>
			<remove_style_all />
			<style name="style_tab" />
			<style name="style_button_pressed" selector="pressed" />
			<subject_set_int_event subject="subject_nav_index" value="#ref_nav_messages" trigger="clicked" />
			<screen_create_event anim_type="fade_in" duration="200" screen="screen_messages" />
			<bind_flag_if_not_eq flag="clickable" subject="subject_nav_index" ref_value="#ref_nav_messages" />
			<column
				height="100%"
				padding_side="0"
				padding_inside="#base_lib_unit_sm"
				horizontal_align="center"
				vertical_align="center"
				clickable="false"
				event_bubble="true"
			>
				<image_mono src="icon_messages">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_messages" />
				</image_mono>
				<text text="Messages" font="font_md">
					<bind_style subject="subject_nav_index" name="style_tab_active" ref_value="#ref_nav_messages" />
				</text>
			</column>
		</lv_button>
	</view>
</component>

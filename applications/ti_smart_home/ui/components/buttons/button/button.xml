<component>
	<styles>
		<style
			name="style_base"
			width="content"
			height="content"
			radius="#base_lib_radius_lg"
			pad_hor="#base_lib_unit_lg"
			pad_ver="#base_lib_unit_sm"
			text_font="font_sm"
		/>
	</styles>
	<api>
		<prop name="text" type="string" default="Button" />
	</api>
	<view extends="lv_button">
		<style name="style_base" />
		<style name="style_button" />
		<style name="style_button_pressed" selector="pressed" />
		<lv_label text="$text" />
	</view>
</component>

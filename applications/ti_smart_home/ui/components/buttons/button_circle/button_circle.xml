<component>
	<api>
		<prop name="icon" type="image" default="icon_plus" />
		<prop name="bg_color" type="color" default="#color_accent" />
		<prop name="bg_opa" type="opa" default="20%" />
		<prop name="color" type="color" default="#color_accent" />
		<prop name="size" type="int" default="48" />
	</api>
	<styles>
		<style name="button_pressed" bg_opa="40%" transform_height="0" transform_width="0" />
	</styles>
	<view
		extends="lv_button"
		width="$size"
		style_bg_color="$bg_color"
		style_bg_opa="$bg_opa"
		height="$size"
		adv_hittest=""
		clickable="true"
		style_radius="100"
		style_shadow_width="0"
		style_bg_image_src="$icon"
		style_bg_image_recolor="$color"
		style_bg_image_recolor_opa="100%"
	>
		<style name="button_pressed" selector="pressed" />
	</view>
</component>

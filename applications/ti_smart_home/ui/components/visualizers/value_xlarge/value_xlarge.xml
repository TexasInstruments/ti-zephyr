<component>
	<styles>
		<style name="style_base" width="content" height="content" />
		<style name="style_value" text_font="font_xxxl" />
		<style name="style_unit" text_font="font_xl" />
	</styles>

	<api>
		<prop name="value" type="subject" default="subject_test" />
		<prop name="format" type="string" default="%d" />
		<prop name="unit" type="string" default="°C" />
	</api>
	<view clickable="false" click_focusable="false" adv_hittest="false">
		<remove_style_all />
		<style name="style_base" />
		<lv_spangroup clickable="false">
			<lv_spangroup-span bind_text="$value" bind_text-fmt="$format" style="style_value" />
			<lv_spangroup-span text="$unit" style="style_unit" />
		</lv_spangroup>
	</view>
</component>

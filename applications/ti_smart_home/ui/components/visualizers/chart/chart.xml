<component>
	<previews>
		<preview width="400" height="300" />
	</previews>

	<api>
		<prop name="chart_type" type="enum:lv_chart_type" default="line" />
		<prop name="color" type="color" default="#color_accent" />
		<prop name="min_value" type="int" default="0" />
		<prop name="max_value" type="int" default="100" />
		<prop name="tick_count" type="int" default="5" />
		<prop name="point_count" type="int" default="10" />
	</api>

	<styles>
		<style name="style_base" pad_column="0" pad_all="0" />
		<style
			name="style_chart"
			flex_grow="1"
			height="100%"
			pad_ver="16"
			pad_hor="16"
			pad_column="#base_lib_unit_md"
			border_width="0"
			line_width="1"
			line_opa="12%"
			margin_ver="0"
		/>
		<style name="style_series_items" line_width="0" radius="50" />
		<style name="style_series_indicator" width="#base_lib_unit_sm" height="#base_lib_unit_sm" />
		<style
			name="style_scale"
			height="95%"
			pad_top="16"
			width="#base_lib_unit_xxl"
			text_font="font_sm"
			line_width="0"
		/>
		<style name="style_scale_indicator" length="0" pad_left="#base_lib_unit_xs" />
	</styles>

	<view extends="row" style_pad_ver="0">
		<style name="style_base" />
		<lv_scale
			mode="vertical_left"
			min_value="$min_value"
			max_value="$max_value"
			major_tick_every="1"
			total_tick_count="$tick_count"
		>
			<style name="style_scale" />
			<style name="style_scale_indicator" selector="indicator" />
		</lv_scale>

		<lv_chart
			style_line_width="4"
			type="bar"
			point_count="$point_count"
			hor_div_line_count="$tick_count"
			ver_div_line_count="0"
		>
			<remove_style_all />
			<style name="style_chart" />
			<style name="style_series_items" selector="items" />
			<style name="style_series_indicator" selector="indicator" />
			<lv_chart-series color="$color" values="12 11 22 21 4 8 14" />
			<lv_chart-axis axis="primary_y" min_value="$min_value" max_value="$max_value" />
		</lv_chart>
	</view>
</component>

<screen>
	<consts>
		<color name="color_view_bg" value="0xE3F5DB" />
		<color name="color_card1_bg" value="0xFFFEF9" />
		<color name="color_card1_text" value="0x484242" />
		<color name="color_card2_bg" value="0xF6EAB8" />
		<color name="color_card2_text" value="0x564500" />
		<color name="color_card3_bg" value="0x98D79A" />
		<color name="color_card3_text" value="0x0E3E02" />
	</consts>
	<view>
		<subject_set_int_event subject="subject_nav_index" value="#ref_nav_messages" trigger="screen_loaded" />

		<column
			name="root"
			width="100%"
			height="100%"
			padding_side="0"
			padding_inside="#base_lib_unit_md"
			scrollable="false"
			style_pad_top="12"
			style_bg_color="#color_view_bg"
			style_bg_opa="100%"
		>
			<header name="statusbar" style_pad_hor="#base_lib_unit_xl" />

			<column
				name="content"
				width="100%"
				grow="1"
				padding_side="0"
				padding_inside="#base_lib_unit_xl"
				style_pad_hor="#base_lib_unit_xl"
				style_pad_bottom="#base_lib_unit_md"
				scrollable="false"
			>
				<column width="100%">
					<h1 text="Messages" />
				</column>

				<!-- Detail card sits above the lists and reflects the tapped contact:
				     list_contact already writes these subjects on click. -->
				<card_empty
					name="card_contact"
					flex_flow="row"
					width="100%"
					height="184"
					style_flex_cross_place="center"
					style_bg_color="#color_card3_bg"
					style_text_color="#color_card3_text"
					scrollable="false"
				>
					<image name="contact_icon" src="image_contact_large" bind_src="subject_contact_img" />
					<column grow="1" padding_side="0" padding_inside="-4" style_pad_hor="#base_lib_unit_lg">
						<h2 bind_text="subject_contact_name" width="100%" long_mode="dots" />
						<text
							bind_text="subject_contact_email"
							font="font_md"
							width="100%"
							long_mode="dots"
							style_text_opa="64%"
						/>
						<text
							bind_text="subject_contact_phone"
							font="font_md"
							width="100%"
							style_text_opa="64%"
						/>
					</column>
					<row padding_inside="#base_lib_unit_md" vertical_align="center">
						<button_circle icon="icon_email" size="56" bg_opa="0" color="#color_card3_text" />
						<button_circle
							icon="icon_call"
							size="64"
							bg_color="0xfff"
							bg_opa="100%"
							color="#color_card3_text"
						/>
						<button_circle icon="icon_message" size="56" bg_opa="0" color="#color_card3_text" />
					</row>
				</card_empty>

				<!-- Both lists keep the container's padding on all sides, so rows (and their
				     dividers) never reach the rounded corners. That replaces clip_corner, which
				     renders the children of the corner strips through ARGB8888 layers. -->
				<list_container
					name="message_list"
					width="100%"
					height="340"
					flex_grow="0"
					style_pad_all="#base_lib_unit_xl"
					style_pad_top="64"
					scroll_chain_ver="false"
				>
			<list_message
				thumbnail="image_avatar_lisa_small"
				time="10:24"
				title="Lisa"
				message="Can you pick up milk on the way?"
			/>
			<list_message
				thumbnail="icon_charge"
				time="08:15"
				title="EV Charger"
				message="Charging complete."
			/>
			<list_message
				thumbnail="image_contact_alex_small"
				time="Yesterday 19:44"
				title="Alex"
				message="Dinner at 7?"
			/>
			<list_message
				thumbnail="icon_messages"
				time="Yesterday 18:23"
				title="Security"
				message="Front door unlocked"
			/>
					<row
						y="-64"
						floating="true"
						horizontal_align="start"
						vertical_align="center"
						padding_inside="#base_lib_unit_sm"
						width="100%"
						style_bg_color="#color_bg"
						style_bg_opa="100%"
						style_pad_top="24"
						style_shadow_width="30"
						style_shadow_color="#color_bg"
						style_shadow_opa="100%"
						style_shadow_spread="10"
					>
						<image_mono src="icon_messages" style_image_recolor="#color_card1_text" />
						<h3 text="Inbox" />
					</row>
				</list_container>

				<list_container
					name="contact_list"
					width="100%"
					flex_grow="1"
					style_pad_all="#base_lib_unit_xl"
					style_pad_top="64"
					scroll_chain_ver="false"
				>
			<list_contact
				thumbnail="image_contact_small"
				contact_name="Noah Davis"
				email="noah.davis@gmail.com"
				phone="+1 45 678 45 56"
			/>
			<list_contact
				thumbnail="image_contact_alex_small"
				contact_name="Alex Doe"
				email="alexdoe@gmail.com"
				phone="+1 45 543 34 34"
			/>
			<list_contact
				thumbnail="image_contact_lukas_small"
				contact_name="Lukas Schneider"
				email="lukas.schneider@gmail.com"
				phone="+49 151 23456789"
			/>
			<list_contact
				thumbnail="image_avatar_lisa_small"
				contact_name="Lisa Swift"
				email="lisa.swift@gmail.com"
				phone="+33 6 15 34 76 78"
			/>
			<list_contact
				thumbnail="image_contact_emma_small"
				contact_name="Emma Dubois"
				email="emma.dubois@gmail.com"
				phone="+33 6 12 34 56 78"
			/>
			<list_contact
				thumbnail="image_contact_marco_small"
				contact_name="Marco Rossi"
				email="marco.rossi@gmail.com"
				phone="+39 320 123 4567"
			/>
			<list_contact
				thumbnail="image_contact_sofia_small"
				contact_name="Sofia Andersson"
				email="sofia.andersson@gmail.com"
				phone="+46 70 123 45 67"
			/>
			<list_contact
				thumbnail="image_contact_oliver_small"
				contact_name="Oliver Novak"
				email="oliver.novak@gmail.com"
				phone="+420 601 123 456"
			/>
			<list_contact
				thumbnail="image_contact_thomas_small"
				contact_name="Thomas Müller"
				email="thomas.mueller@gmail.com"
				phone="+49 176 98765432"
			/>
			<list_contact
				thumbnail="image_contact_isabella_small"
				contact_name="Isabella Garcia"
				email="isabella.garcia@gmail.com"
				phone="+34 612 345 678"
			/>
			<list_contact
				thumbnail="image_contact_noah_small"
				contact_name="Noah Jensen"
				email="noah.jensen@gmail.com"
				phone="+45 21 23 45 67"
			/>
			<list_contact
				thumbnail="image_contact_elena_small"
				contact_name="Elena Petrova"
				email="elena.petrova@gmail.com"
				phone="+359 88 123 4567"
			/>
					<row
						y="-64"
						floating="true"
						horizontal_align="start"
						vertical_align="center"
						padding_inside="#base_lib_unit_sm"
						width="100%"
						style_bg_color="#color_bg"
						style_bg_opa="100%"
						style_pad_top="24"
						style_shadow_width="30"
						style_shadow_color="#color_bg"
						style_shadow_opa="100%"
						style_shadow_spread="10"
					>
						<image_mono src="icon_contacts" style_image_recolor="#color_card1_text" />
						<h3 text="Contacts" />
					</row>
				</list_container>
			</column>

			<navbar />
		</column>
	</view>
</screen>

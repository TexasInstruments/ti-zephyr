&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pc2 &i2c2_sda_pc3>;
	pinctrl-names = "default";
	clock-frequency = <1000000>;

	ti_hdc2080@40 {
		compatible = "ti,hdc2080";
		reg = <0x40>;
		int-gpios = <&gpioa 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_K(512)>;
};

&sram0 {
	reg = <0x20200000 DT_SIZE_K(128)>;
};
